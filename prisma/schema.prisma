generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model GhlLocation {
  id                   Int           @id @default(autoincrement())
  locationId           String        @unique @map("location_id") @db.VarChar(100)
  name                 String        @db.VarChar(255)
  encryptedPrivateKey  String        @map("encrypted_private_key") @db.Text
  keyHint              String?       @map("key_hint") @db.VarChar(20)
  currency             String        @default("AED") @db.VarChar(10)
  timezone             String        @default("Asia/Dubai") @db.VarChar(100)
  isActive             Boolean       @default(true) @map("is_active")
  lastSyncAt           DateTime?     @map("last_sync_at")
  syncStatus           String        @default("idle") @map("sync_status") @db.VarChar(30)
  syncErrorMessage     String?       @map("sync_error_message") @db.Text
  enableBookings       Boolean       @default(true) @map("enable_bookings")
  selectedCalendarIds  String?       @map("selected_calendar_ids") @db.Text
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  users                User[]
  pipelines            Pipeline[]
  pipelineStages       PipelineStage[]
  contacts             Contact[]
  opportunities        Opportunity[]
  tasks                Task[]
  appointments         Appointment[]
  kpiTargets           KpiTarget[]
  stageHistories       OpportunityStageHistory[]
  touchHistories       LeadTouchHistory[]
  shares               DashboardShare[]

  @@map("ghl_locations")
}

model User {
  id            Int          @id @default(autoincrement())
  locationId    String       @map("location_id") @db.VarChar(100)
  ghlUserId     String       @map("ghl_user_id") @db.VarChar(100)
  name          String       @db.VarChar(255)
  email         String?      @db.VarChar(255)
  role          String       @default("Sales Consultant") @db.VarChar(100)
  avatarUrl     String?      @map("avatar_url") @db.Text
  isActive      Boolean      @default(true) @map("is_active")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  location      GhlLocation  @relation(fields: [locationId], references: [locationId], onDelete: Cascade)

  @@unique([locationId, ghlUserId])
  @@index([locationId])
  @@index([locationId, isActive])
  @@map("users")
}

model Pipeline {
  id            Int             @id @default(autoincrement())
  locationId    String          @map("location_id") @db.VarChar(100)
  ghlPipelineId String          @map("ghl_pipeline_id") @db.VarChar(100)
  name          String          @db.VarChar(255)
  createdAt     DateTime        @default(now()) @map("created_at")

  location      GhlLocation     @relation(fields: [locationId], references: [locationId], onDelete: Cascade)
  stages        PipelineStage[]
  opportunities Opportunity[]

  @@unique([locationId, ghlPipelineId])
  @@index([locationId])
  @@map("pipelines")
}

model PipelineStage {
  id            Int           @id @default(autoincrement())
  locationId    String        @map("location_id") @db.VarChar(100)
  pipelineId    Int           @map("pipeline_id")
  ghlStageId    String        @map("ghl_stage_id") @db.VarChar(100)
  name          String        @db.VarChar(255)
  position      Int           @default(0)

  location      GhlLocation   @relation(fields: [locationId], references: [locationId], onDelete: Cascade)
  pipeline      Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]

  @@unique([locationId, ghlStageId])
  @@index([locationId, pipelineId])
  @@map("pipeline_stages")
}

model Contact {
  id             Int           @id @default(autoincrement())
  locationId     String        @map("location_id") @db.VarChar(100)
  ghlContactId   String        @map("ghl_contact_id") @db.VarChar(100)
  assignedTo     String?       @map("assigned_to") @db.VarChar(100)
  firstName      String?       @map("first_name") @db.VarChar(150)
  lastName       String?       @map("last_name") @db.VarChar(150)
  email          String?       @db.VarChar(255)
  phone          String?       @db.VarChar(100)
  source         String?       @default("Direct") @db.VarChar(100)
  campaign       String?       @db.VarChar(150)
  dateAdded      DateTime      @default(now()) @map("date_added")
  dateUpdated    DateTime      @default(now()) @map("date_updated")
  lastActivityAt DateTime?     @map("last_activity_at")

  location       GhlLocation   @relation(fields: [locationId], references: [locationId], onDelete: Cascade)
  opportunities  Opportunity[]
  tasks          Task[]
  appointments   Appointment[]
  touchHistories LeadTouchHistory[]

  @@unique([locationId, ghlContactId])
  @@index([locationId, assignedTo])
  @@index([locationId, source])
  @@index([locationId, dateAdded])
  @@map("contacts")
}

model Opportunity {
  id               Int           @id @default(autoincrement())
  locationId       String        @map("location_id") @db.VarChar(100)
  ghlOpportunityId String        @map("ghl_opportunity_id") @db.VarChar(100)
  contactId        Int?          @map("contact_id")
  assignedTo       String?       @map("assigned_to") @db.VarChar(100)
  pipelineId       Int           @map("pipeline_id")
  stageId          Int           @map("stage_id")
  name             String        @db.VarChar(255)
  status           String        @default("open") @db.VarChar(50) // open, won, lost, abandoned
  monetaryValue    Float         @default(0) @map("monetary_value")
  source           String?       @default("Direct") @db.VarChar(100)
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @default(now()) @map("updated_at")
  wonAt            DateTime?     @map("won_at")
  lostAt           DateTime?     @map("lost_at")
  assignedAt       DateTime?     @map("assigned_at")
  stageEnteredAt   DateTime      @default(now()) @map("stage_entered_at")

  location         GhlLocation   @relation(fields: [locationId], references: [locationId], onDelete: Cascade)
  contact          Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  pipeline         Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage            PipelineStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  stageHistories   OpportunityStageHistory[]

  @@unique([locationId, ghlOpportunityId])
  @@index([locationId, status, createdAt])
  @@index([locationId, assignedTo, status])
  @@index([locationId, pipelineId, stageId])
  @@index([locationId, source, status])
  @@index([locationId, updatedAt])
  @@index([locationId, wonAt])
  @@map("opportunities")
}

model Task {
  id           Int          @id @default(autoincrement())
  locationId   String       @map("location_id") @db.VarChar(100)
  ghlTaskId    String       @map("ghl_task_id") @db.VarChar(100)
  assignedTo   String?      @map("assigned_to") @db.VarChar(100)
  contactId    Int?         @map("contact_id")
  title        String       @db.VarChar(255)
  body         String?      @db.Text
  dueDate      DateTime?    @map("due_date")
  completed    Boolean      @default(false)
  completedAt  DateTime?    @map("completed_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @default(now()) @map("updated_at")

  location     GhlLocation  @relation(fields: [locationId], references: [locationId], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@unique([locationId, ghlTaskId])
  @@index([locationId, assignedTo, completed, dueDate])
  @@index([locationId, completed, dueDate])
  @@map("tasks")
}

model KpiTarget {
  id               Int          @id @default(autoincrement())
  locationId       String       @map("location_id") @db.VarChar(100)
  ghlUserId        String       @map("ghl_user_id") @db.VarChar(100)
  periodMonth      String       @map("period_month") @db.VarChar(20) // e.g. "2026-09"
  revenueTarget    Float        @default(150000) @map("revenue_target")
  dealsTarget      Int          @default(25) @map("deals_target")
  leadsTarget      Int          @default(200) @map("leads_target")
  tasksTarget      Int          @default(80) @map("tasks_target")

  location         GhlLocation  @relation(fields: [locationId], references: [locationId], onDelete: Cascade)

  @@unique([locationId, ghlUserId, periodMonth])
  @@index([locationId, periodMonth])
  @@map("kpi_targets")
}

model OpportunityStageHistory {
  id              Int          @id @default(autoincrement())
  locationId      String       @map("location_id") @db.VarChar(100)
  opportunityId   Int          @map("opportunity_id")
  pipelineId      Int          @map("pipeline_id")
  stageId         Int          @map("stage_id")
  fromStageId     Int?         @map("from_stage_id")
  assignedTo      String?      @map("assigned_to") @db.VarChar(100)
  enteredAt       DateTime     @default(now()) @map("entered_at")
  exitedAt        DateTime?    @map("exited_at")
  durationSeconds Int?         @map("duration_seconds")

  location        GhlLocation  @relation(fields: [locationId], references: [locationId], onDelete: Cascade)
  opportunity     Opportunity  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([locationId, pipelineId, stageId, enteredAt])
  @@index([locationId, assignedTo, enteredAt])
  @@index([opportunityId])
  @@map("opportunity_stage_history")
}

model LeadTouchHistory {
  id                      Int          @id @default(autoincrement())
  locationId              String       @map("location_id") @db.VarChar(100)
  contactId               Int          @map("contact_id")
  assignedTo              String       @map("assigned_to") @db.VarChar(100)
  assignedAt              DateTime     @map("assigned_at")
  firstTouchAt            DateTime?    @map("first_touch_at")
  responseDurationSeconds Int?         @map("response_duration_seconds")
  channel                 String?      @default("call") @db.VarChar(50)

  location                GhlLocation  @relation(fields: [locationId], references: [locationId], onDelete: Cascade)
  contact                 Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([locationId, assignedTo, assignedAt])
  @@map("lead_touch_history")
}

model DashboardShare {
  id           Int          @id @default(autoincrement())
  token        String       @unique @db.VarChar(100)
  locationId   String       @map("location_id") @db.VarChar(100)
  title        String       @default("Sales Command Center") @db.VarChar(255)
  filtersJson  String?      @map("filters_json") @db.Text
  expiresAt    DateTime?    @map("expires_at")
  maskPii      Boolean      @default(true) @map("mask_pii")
  isEnabled    Boolean      @default(true) @map("is_enabled")
  createdAt    DateTime     @default(now()) @map("created_at")

  location     GhlLocation  @relation(fields: [locationId], references: [locationId], onDelete: Cascade)

  @@index([locationId])
  @@map("dashboard_shares")
}

model Appointment {
  id                   Int          @id @default(autoincrement())
  locationId           String       @map("location_id") @db.VarChar(100)
  ghlAppointmentId     String       @map("ghl_appointment_id") @db.VarChar(100)
  title                String?      @db.VarChar(255)
  contactId            Int?         @map("contact_id")
  contactName          String?      @map("contact_name") @db.VarChar(255)
  contactPhone         String?      @map("contact_phone") @db.VarChar(100)
  contactEmail         String?      @map("contact_email") @db.VarChar(255)
  assignedTo           String?      @map("assigned_to") @db.VarChar(100)
  calendarId           String?      @map("calendar_id") @db.VarChar(100)
  calendarName         String?      @map("calendar_name") @db.VarChar(255)
  startTime            DateTime     @map("start_time")
  endTime              DateTime?    @map("end_time")
  status               String       @default("confirmed") @db.VarChar(50) // confirmed, cancelled, showed, noshow, invalid
  meetingLocationType  String?      @default("zoom") @map("meeting_location_type") @db.VarChar(100) // zoom, google_meet, phone, in_person, etc.
  meetingUrl           String?      @map("meeting_url") @db.Text
  notes                String?      @db.Text
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  location             GhlLocation  @relation(fields: [locationId], references: [locationId], onDelete: Cascade)
  contact              Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@unique([locationId, ghlAppointmentId])
  @@index([locationId, startTime])
  @@index([locationId, assignedTo, startTime])
  @@index([locationId, status])
  @@map("appointments")
}

